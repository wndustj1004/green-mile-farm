# 그린마일 팜 환경변수 템플릿 (실제 값은 .env.local에 넣으세요)
# 이 파일은 "어떤 키가 필요한지"만 알려주는 견본입니다(깃에 올라가도 안전).

# Supabase — 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. RLS를 우회하므로 절대 브라우저에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 개발자 콘솔 — 실행할 도메인을 Web 플랫폼에 등록해야 지도가 뜹니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=

# 상태 점검 API(/api/health) 보호용 Bearer 토큰.
# Vercel Cron이 이 값으로 호출하며, 일치하지 않으면 401을 돌려줍니다.
CRON_SECRET=
